{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/assets/image.png",
    "type": "kitty-direct",
    "padding": {
      "top": 3,
      "left": 6
    },
    "width": 35,
    "height": 18
  },

  "display": {
    "separator": "  "
  },
  "modules": [
    "break",

    { "type": "custom", "format": "" },
    { "type": "custom", "format": "" },

    {
      "type": "custom",
      "format": "\u001b[38;2;189;147;249m╭──────────────────────────󰭟 󰭟 󰭟 󰭟 󰭟 󰭟 󰭟 󰭟 󰭟 ─────────────────────────╮"
    },
    {
      "type": "os",
      "key": "\u001b[38;2;189;147;249m│\u001b[0m \u001b[37m󰧨 \u001b[0m"
    },
    {
      "type": "kernel",
      "key": "\u001b[38;2;189;147;249m│\u001b[0m \u001b[33m󰻀 \u001b[0m",
      "keyColor": "yellow"
    },
    {
      "type": "uptime",
      "key": "\u001b[38;2;189;147;249m│\u001b[0m \u001b[34m \u001b[0m",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;189;147;249m╰─────────────────────────────────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;255;121;198m╭──────────────────────────󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 ─────────────────────────╮"
    },
    {
      "type": "chassis",
      "key": "\u001b[38;2;255;121;198m│\u001b[0m \u001b[38;2;189;147;249m \u001b[0m"
    },
    {
      "type": "packages",
      "key": "\u001b[38;2;255;121;198m│\u001b[0m \u001b[32m \u001b[0m"
    },
    {
      "type": "shell",
      "key": "\u001b[38;2;255;121;198m│\u001b[0m \u001b[33m \u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;255;121;198m╰─────────────────────────────────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;139;233;253m╭──────────────────────────󰚌 󰚌 󰚌 󰚌 󰚌 󰚌 󰚌 󰚌 󰚌 ─────────────────────────╮"
    },
    {
      "type": "cpu",
      "key": "\u001b[38;2;139;233;253m│\u001b[0m \u001b[34m \u001b[0m"
    },
    {
      "type": "gpu",
      "key": "\u001b[38;2;139;233;253m│\u001b[0m \u001b[38;2;255;121;198m󱤓 \u001b[0m"
    },
    {
      "type": "memory",
      "key": "\u001b[38;2;139;233;253m│\u001b[0m \u001b[38;2;189;147;249m \u001b[0m",
      "keyColor": "white"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;139;233;253m╰─────────────────────────────────────────────────────────────────────╯"
    },

    "break"
  ]
}
