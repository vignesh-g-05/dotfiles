{
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "mute ",
        "format-bluetooth":"󰂰",
        "format-icons": {
            "headphones": "",
            "bluetooth": "󰥰",
            "handsfree": "",
            "headset": "󱡬",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["🕨","🕩","🕪"]
        },
        "justify": "center",
        "on-click": "swayosd-client --output-volume mute-toggle"
    },

    "network": {
        "interface": "wlp2s0",
        "interval": 10,
        "on-click": "~/.local/bin/hyprltm-net",
        "format": "{ifname}",
        "format-wifi": "{signalStrength}% {icon}",
        "format-ethernet": "",
        "format-disconnected": "",
        "format-disabled": "󰤭",
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "tooltip-format-wifi": "{essid} | {bandwidthDownBits}",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "Disconnected",
        "tooltip-format-disabled": "Wifi Disabled",
        "max-length": 50,
        "format-icons": {
            "wifi": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"]
        }
    },

    "battery": {
        "interval": 30,
        "states": {
            "good": 100,
            "warning": 40,
            "critical": 20
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰂄",
        "format-plugged": "{capacity}% 󰂄 ",
        "format-icons": [
            "󰁻",
            "󰁼",
            "󰁾",
            "󰂀",
            "󰂂",
            "󰁹"
        ]
    },

    "custom/battery-alert": {
        "exec": "~/.config/waybar/scripts/battery-alert.sh",
        "interval": 30
    },

    "custom/power": {
        "format": "",
        "on-click": "~/.config/shared/scripts/power-menu.sh",
        "tooltip": false
    }
}
