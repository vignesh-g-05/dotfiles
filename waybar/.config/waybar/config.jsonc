{
    "layer": "top",
    "position": "top",
    "modules-left": ["custom/logo", "custom/clock", "clock"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["backlight", "pulseaudio", "network",  "battery", "custom/notification", "custom/power" ],
    "reload_style_on_change": true,

    "include": [
        "./modules/left-modules.jsonc",
        "./modules/center-modules.jsonc",
        "./modules/right-modules.jsonc"
    ]

}
