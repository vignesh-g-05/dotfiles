{
    "layer": "top",
    "position": "top",
    "modules-left": [
        "custom/logo",
        "custom/clock",
        "clock",
        "backlight"
    ],
    "modules-center": [
        "custom/theme-switcher",
        "hyprland/workspaces",
        "custom/notification"
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "battery",
        "custom/battery-alert",
        "custom/power"
    ],
    "reload_style_on_change": true,

    "include": [
        "./modules/left-modules.jsonc",
        "./modules/center-modules.jsonc",
        "./modules/right-modules.jsonc"
    ]

}
