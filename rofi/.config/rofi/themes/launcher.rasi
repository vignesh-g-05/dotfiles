configuration {
    display-drun: "";
    show-icons: true;
}

window {
    font:		"JetBrainsMono Nerd Font Propo 16";
    fullscreen:		true;
    padding:		0px;
    margin:		0px;
    background-color:	transparent;
}

mainbox {
    children:	        [ "inputbar", "message", "listview" ];
    background-color:   transparent;
    spacing:            24px;
    margin:             0px;
    padding:            10% 15%;
}

inputbar {
    children:	["placeholder", "prompt", "entry", "placeholder"];
    background-color: transparent;
    spacing:	20px;
}

placeholder {
    background-color: transparent;
}

prompt {
    background-color:	white / 15%;
    color:	        white;
    border-radius:      10px;
    padding:            10px 15px;
}

entry {
    expand:		false;
    background-color:	white / 15%;
    color:	        white / 80%;
    padding:            10px 15px;
    border-radius:      10px;
    placeholder:        " ";
    width:		40%;
}

listview {
    columns:	6;
    scrollbar:	false;
    spacing:    30px;
    border:	none;
    background-color: transparent;
}

element {
    padding:		20px;
    orientation:	vertical;
    children:		["element-icon"];
    background-color:	transparent;
    border-radius:	10px;
}

element-icon {
    padding:		20px;
    size:		60px;
    background-color:	transparent;
}

element normal.normal {
    background-color:	transparent;
}
element alternate.normal {
    background-color:	transparent;
}
element selected.normal {
    background-color:   white / 25%;
}
